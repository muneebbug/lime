{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for all Wheel windows",
  "windows": ["main", "overlay", "tool-*", "settings", "palette"],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "store:default",
    "window-state:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
